# 앱 실행용 환경변수 이름만 둔다. 실제 값은 Git 비추적 .env.local에 둔다.

# AI (DEC-004, DEC-011)
# openai | anthropic (기본 openai)
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# fake면 실제 AI 대신 예시 결과(체험 모드 / Test). 실제 AI를 쓰려면 비운다
AI_CLIENT=fake
# 월 AI 사용 상한(USD)
AI_MONTHLY_BUDGET_USD=30
# 분석 1건당 이미지 조각 상한
AI_MAX_SLICES_PER_ANALYSIS=24
